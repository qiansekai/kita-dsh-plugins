{
  "name": "kita-office-preview",
  "version": "0.1.0",
  "description": "Office document preview (Word .docx / Excel .xlsx / PowerPoint .pptx) for the DSH right Sidebar file viewer",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@js-preview/excel": "^1.7.14",
    "@types/react": "~18.3.1",
    "docx-preview": "^0.4.0",
    "esbuild": "^0.25.0",
    "pptx-preview": "^1.0.7",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "license": "MIT"
}
