{
  "name": "@dsh-external/dsh-quota-retry",
  "version": "0.1.0",
  "description": "余额/额度不足（QUOTA）无界长退避 + 鉴权失败（AUTH）有界短退避的自动重试：匹配的错误码等待后重试，而不是让本轮运行直接停下",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
